// GiveDirect — donation platform schema
// Money is stored in integer minor units (cents). Never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in `prisma.config.ts`; the runtime client is
// constructed with a driver adapter (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (@auth/prisma-adapter) models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users

  // Public creator profile (rendered on donation pages)
  bio String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  pages               DonationPage[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Donation pages
// ---------------------------------------------------------------------------

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model DonationPage {
  id            String     @id @default(cuid())
  userId        String
  slug          String     @unique
  title         String
  description   String?    @db.Text
  coverImageUrl String?
  status        PageStatus @default(DRAFT)

  currency          String  @default("usd")
  suggestedAmounts  Int[]   @default([1000, 2500, 5000])
  allowCustomAmount Boolean @default(true)
  minAmountCents    Int     @default(100)
  goalAmountCents   Int?
  showProgressBar   Boolean @default(true)
  collectDonorName  Boolean @default(true)
  collectMessage    Boolean @default(false)
  thankYouMessage   String? @db.Text

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  noIndex        Boolean @default(false)

  embedEnabled Boolean @default(true)
  theme        Json? // accent color, radius, layout variant

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations Donation[]
  pageViews PageView[]
  dailyStats PageDailyStat[]

  @@index([userId, status])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Donations
// ---------------------------------------------------------------------------

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TrafficSource {
  DIRECT
  EMBED
  REFERRAL
}

/// Donation records. No payment provider is wired up yet, so nothing in the
/// app writes to this table — it is populated by the seed script and read by
/// the dashboard, donation history and analytics. When a processor is added,
/// its identifiers go on this model and the writes start here.
model Donation {
  id                String         @id @default(cuid())
  pageId            String
  amountCents       Int
  currency          String
  platformFeeCents  Int
  netToCreatorCents Int?
  status            DonationStatus @default(PENDING)

  donorName   String?
  donorEmail  String?
  message     String?       @db.Text
  isAnonymous Boolean       @default(false)
  source      TrafficSource @default(DIRECT)

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  refundedAt  DateTime?

  page DonationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, status, createdAt])
}

// ---------------------------------------------------------------------------
// First-party analytics
// ---------------------------------------------------------------------------

model PageView {
  id          String        @id @default(cuid())
  pageId      String
  visitorHash String // hash(ip + ua + daily salt) — no raw PII
  referrer    String?
  country     String?
  source      TrafficSource @default(DIRECT)
  createdAt   DateTime      @default(now())

  page DonationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([createdAt])
}

model PageDailyStat {
  id             String   @id @default(cuid())
  pageId         String
  date           DateTime @db.Date
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  donationCount  Int      @default(0)
  amountCents    Int      @default(0)

  page DonationPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
