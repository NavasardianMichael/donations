# `pnpm install` copies this file to .env when there is none, generating a real
# AUTH_SECRET on the way (scripts/setup.mjs). Every value below is either
# correct for local development already or optional. Adding a key here without
# adding it to your own .env is reported on the next install.
#
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pooled connection used at runtime (PgBouncer / Neon / Supabase pooler).
# Direct connections exhaust the Postgres pool under any real serverless traffic.
# `docker compose up -d` exposes PgBouncer on 6442 and Postgres direct on 5442.
DATABASE_URL="postgresql://postgres:postgres@localhost:6442/givedirect?schema=public&pgbouncer=true"
# Direct, non-pooled connection. Used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres:postgres@localhost:5442/givedirect?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Trust the host header. Required when self-hosting behind a proxy.
AUTH_TRUST_HOST="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Payments — ArCa (Armenian cards, AMD)
# ---------------------------------------------------------------------------
# Issued by the merchant's ACQUIRING BANK (Ameriabank, ACBA, Inecobank…), not
# by ArCa. Leave empty to hide the Armenian-card option instead of failing to
# boot. src/lib/payments/arca.ts
ARCA_USERNAME=""
ARCA_PASSWORD=""
# "test" hits ipaytest.arca.am:8445; "production" hits ipay.arca.am.
ARCA_ENV="test"

# ---------------------------------------------------------------------------
# Payments — Paddle (international cards, USD)
# ---------------------------------------------------------------------------
# Paddle Billing. Leave empty to hide the international option.
# src/lib/payments/paddle.ts
#
# Donation amounts are arbitrary, so there is no catalogue price: every
# transaction builds an ad-hoc price against this single product. Create one
# product in Paddle (e.g. "Donation") and put its `pro_…` id here.
#
# Paddle will NOT accept AMD. International donations are denominated in USD,
# using the per-page USD amount ladder the creator authors in page settings.
PADDLE_API_KEY=""
PADDLE_PRODUCT_ID=""
# Notifications → your webhook destination → signing secret. Without it the
# webhook rejects every delivery, since an unverified body is worthless.
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENV="sandbox"
# Browser-safe: it can only open a checkout the server already created. Not
# NEXT_PUBLIC_ — the checkout page passes it down as a prop, so there is one
# source of truth and nothing is frozen into the bundle at build time.
# Paddle dashboard → Developer tools → Authentication → Client-side tokens.
PADDLE_CLIENT_TOKEN=""
#
# Paddle dashboard setup that is NOT code and cannot be skipped:
#   1. Checkout → Website approval: add the origin of NEXT_PUBLIC_APP_URL.
#   2. Checkout → Checkout settings → Default payment link:
#        <origin>/paddle/checkout
#   3. Notifications: add <origin>/api/payments/paddle/webhook and subscribe to
#      transaction.completed, transaction.payment_failed, transaction.canceled.
# `localhost` is rejected by Paddle, so local testing needs a tunnel (ngrok)
# with NEXT_PUBLIC_APP_URL pointed at the tunnel origin.

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Optional in development. When empty, verification and password-reset links
# are printed to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="GiveDirect <noreply@example.com>"
# Where contact-form submissions are delivered.
CONTACT_EMAIL_TO="support@example.com"

# ---------------------------------------------------------------------------
# Analytics / app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Fees
# ---------------------------------------------------------------------------
# Platform fee, in percent. Displayed only — nothing is charged. src/lib/fees.ts
PLATFORM_FEE_PERCENT="5"

# ---------------------------------------------------------------------------
# Cron + rate limiting
# ---------------------------------------------------------------------------
# Bearer token that guards /api/cron/*
CRON_SECRET=""
# Rotated daily and mixed into visitor hashes so no raw IP is ever stored.
ANALYTICS_SALT="change-me-in-production"

# Optional. When both are set, rate limiting uses Upstash Redis (correct across
# serverless instances). Otherwise it falls back to a per-instance in-memory
# limiter, which is fine for local development only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
