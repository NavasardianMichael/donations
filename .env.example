# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pooled connection used at runtime (PgBouncer / Neon / Supabase pooler).
# Direct connections exhaust the Postgres pool under any real serverless traffic.
# `docker compose up -d` exposes PgBouncer on 6442 and Postgres direct on 5442.
DATABASE_URL="postgresql://postgres:postgres@localhost:6442/givedirect?schema=public&pgbouncer=true"
# Direct, non-pooled connection. Used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres:postgres@localhost:5442/givedirect?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Trust the host header. Required when self-hosting behind a proxy.
AUTH_TRUST_HOST="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Deliberately none. No payment provider is integrated: the Donate button is
# disabled and the app never creates a Donation record. Provider keys get
# declared here and in src/lib/env.ts when one is added.

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Optional in development. When empty, verification and password-reset links
# are printed to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="GiveDirect <noreply@example.com>"
# Where contact-form submissions are delivered.
CONTACT_EMAIL_TO="support@example.com"

# ---------------------------------------------------------------------------
# Analytics / app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Fees
# ---------------------------------------------------------------------------
# Platform fee, in percent. Displayed only — nothing is charged. src/lib/fees.ts
PLATFORM_FEE_PERCENT="5"

# ---------------------------------------------------------------------------
# Cron + rate limiting
# ---------------------------------------------------------------------------
# Bearer token that guards /api/cron/*
CRON_SECRET=""
# Rotated daily and mixed into visitor hashes so no raw IP is ever stored.
ANALYTICS_SALT="change-me-in-production"

# Optional. When both are set, rate limiting uses Upstash Redis (correct across
# serverless instances). Otherwise it falls back to a per-instance in-memory
# limiter, which is fine for local development only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
